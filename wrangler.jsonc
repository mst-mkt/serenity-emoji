{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "serenity-emoji",
  "main": "./src/index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
    },
    "traces": {
      "enabled": true,
    },
  },
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "64d2272c32b14f84b8e8e62f04f2cc60",
    },
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "serenity-emoji",
    },
  ],
  "triggers": {
    "crons": ["0 * * * *", "30 0 */3 * *"],
  },
  "secrets": {
    "required": ["GITHUB_TOKEN"],
  },
  "workers_dev": false,
  "routes": [
    {
      "custom_domain": true,
      "pattern": "serenity.keito.dev",
    },
  ],
}
